# =====================================================================
# BANK WEBHOOK GATEWAY - SUPABASE ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env để chạy local, hoặc nhập lên Vercel.
# =====================================================================

# 1. Supabase Configurations (Bắt buộc cho cả Local và Vercel Serverless)
# Lấy từ Supabase Dashboard: Settings > API > Project URL & anon/service_role key
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# 2. Mã khóa mã hóa thông tin nhạy cảm trong Supabase DB (Gmail Pass, OAuth Secret, Token...)
ENCRYPTION_SECRET="super-secret-encryption-key-kos-2026"

# 3. Mã khóa bảo mật dành cho Cron Job quét giao dịch tự động (Tùy chọn)
# Vercel Cron hoặc Poller ngoài sẽ gửi Bearer Token khớp với giá trị này
CRON_SECRET="your-secure-cron-secret-token"

# 4. Mật khẩu mặc định truy cập trang Admin Dashboard (Mặc định là admin123 nếu để trống)
ADMIN_PASSWORD="admin123"

# 5. Các biến môi trường tùy chọn (Có thể cài trực tiếp trên Admin Dashboard)
MB_ACCOUNT_NUMBER=""
MB_ACCOUNT_NAME="CỔNG THANH TOÁN NGÂN HÀNG"
DEFAULT_CALLBACK_URL=""
CALLBACK_SECRET="super-secret-callback-token"
